{
  "cards": {
    "understand":           {"prompt": "understand.md", "schema": "schema/understand.schema.json", "thinking": "off", "max_tokens": 900},
    "present.destinations": {"prompt": "present/destinations.md", "schema": "schema/present.destinations.schema.json", "thinking": "off", "max_tokens": 1400, "voice": true},
    "present.variants":     {"prompt": "present/variants.md", "schema": "schema/present.variants.schema.json", "thinking": "off", "max_tokens": 2000, "voice": true},
    "present.compare":      {"prompt": "present/compare.md", "schema": "schema/present.compare.schema.json", "thinking": "off", "max_tokens": 1600, "voice": true},
    "present.update":       {"prompt": "present/update.md", "schema": "schema/present.update.schema.json", "thinking": "off", "max_tokens": 1600, "voice": true},
    "present.info":         {"prompt": "present/info.md", "schema": "schema/present.info.schema.json", "thinking": "off", "max_tokens": 900, "voice": true},
    "present.aftercare":    {"prompt": "present/aftercare.md", "schema": "schema/present.aftercare.schema.json", "thinking": "off", "max_tokens": 900, "voice": true},
    "present.fallback":     {"prompt": "present/fallback.md", "schema": "schema/present.fallback.schema.json", "thinking": "off", "max_tokens": 600, "voice": true}
  },
  "routes": [
    {"id": "act.choose_destination", "when": {"action": ["choose_destination"]},
     "steps": ["apply_patch", "search", "build_variants", "check", "sensitivity", "ask_or_assume", "upsell"], "present": "present.variants"},
    {"id": "act.answer.update", "when": {"action": ["answer_question", "set_chip"], "has": ["destination"], "stage": ["selection", "cart"]},
     "steps": ["apply_patch", "search", "build_variants", "check", "sensitivity", "ask_or_assume", "upsell"], "present": "present.update"},
    {"id": "act.answer.variants", "when": {"action": ["answer_question", "set_chip"], "has": ["destination"]},
     "steps": ["apply_patch", "search", "build_variants", "check", "sensitivity", "ask_or_assume", "upsell"], "present": "present.variants"},
    {"id": "act.answer.destinations", "when": {"action": ["answer_question", "set_chip"], "missing": ["destination"]},
     "steps": ["apply_patch", "find_destinations", "quote_destinations", "sensitivity", "ask_or_assume"], "present": "present.destinations"},
    {"id": "act.swap_hotel", "when": {"action": ["swap_hotel"]},
     "steps": ["resolve_refs", "build_variants", "check", "upsell"], "present": "present.update"},
    {"id": "act.compare", "when": {"action": ["compare"]},
     "steps": ["resolve_refs", "compare"], "present": "present.compare"},
    {"id": "act.cart", "when": {"action": ["choose_variant", "add_to_cart"]},
     "steps": ["resolve_refs", "cart_add"], "present": null},
    {"id": "act.checkout", "when": {"action": ["checkout"]},
     "steps": ["checkout"], "present": null},
    {"id": "act.pay", "when": {"action": ["pay"]},
     "steps": ["pay"], "present": null},
    {"id": "act.order_action", "when": {"action": ["order_action"]},
     "steps": ["post_purchase"], "present": "present.aftercare"},

    {"id": "f.post_purchase", "when": {"intent": ["post_purchase"]},
     "steps": ["resolve_refs", "post_purchase"], "present": "present.aftercare"},
    {"id": "f.fallback", "when": {"intent": ["smalltalk", "out_of_scope"]},
     "steps": [], "present": "present.fallback"},
    {"id": "f.checkout", "when": {"intent": ["checkout"]},
     "steps": ["checkout"], "present": null},
    {"id": "f.cart", "when": {"intent": ["cart"]},
     "steps": ["resolve_refs", "cart_add"], "present": null},
    {"id": "f.compare", "when": {"intent": ["compare"]},
     "steps": ["resolve_refs", "compare"], "present": "present.compare"},
    {"id": "f.info", "when": {"intent": ["info"]},
     "steps": ["resolve_refs", "info_lookup"], "present": "present.info"},
    {"id": "f.choose_destination", "when": {"intent": ["choose"], "stage": ["inspiration"]},
     "steps": ["resolve_refs", "apply_patch", "search", "build_variants", "check", "sensitivity", "ask_or_assume", "upsell"], "present": "present.variants"},
    {"id": "f.choose_variant", "when": {"intent": ["choose"], "stage": ["selection", "cart"]},
     "steps": ["resolve_refs", "cart_add"], "present": null},
    {"id": "e.rebuild", "when": {"intent": ["refine", "answer"], "has": ["destination"], "stage": ["selection", "cart"]},
     "steps": ["apply_patch", "search", "build_variants", "check", "sensitivity", "ask_or_assume", "upsell"], "present": "present.update"},
    {"id": "bcd.variants", "when": {"intent": ["new_trip", "refine", "answer"], "has": ["destination"]},
     "steps": ["apply_patch", "search", "build_variants", "check", "sensitivity", "ask_or_assume", "upsell"], "present": "present.variants"},
    {"id": "a.destinations", "when": {"intent": ["new_trip", "refine", "answer"], "missing": ["destination"]},
     "steps": ["apply_patch", "image_match", "find_destinations", "quote_destinations", "sensitivity", "ask_or_assume"], "present": "present.destinations"},
    {"id": "catch_all", "when": {},
     "steps": [], "present": "present.fallback"}
  ]
}
