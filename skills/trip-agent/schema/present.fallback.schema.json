{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "present.fallback card output",
  "description": "Smalltalk / out of scope / cannot help: an honest short answer and a way back to the trip.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "items",
    "recommended_id",
    "upsell"
  ],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500,
      "description": "Russian text for the user. Numbers only copied from the input."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "maxItems": 0
    },
    "recommended_id": {
      "type": "null",
      "description": "id of one of items (null when nothing is recommended)"
    },
    "upsell": {
      "type": "array",
      "maxItems": 0
    }
  }
}
