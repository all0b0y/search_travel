{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "understand card output",
  "description": "Intent, a brief patch, references to shown items, image reading. No prices, times or totals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "patch",
    "refs",
    "image",
    "info_question",
    "post_purchase"
  ],
  "properties": {
    "intent": {
      "enum": [
        "new_trip",
        "refine",
        "answer",
        "choose",
        "compare",
        "info",
        "cart",
        "checkout",
        "post_purchase",
        "smalltalk",
        "out_of_scope"
      ]
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "unset"
      ],
      "properties": {
        "set": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "destination.name": {
              "type": "string",
              "minLength": 1
            },
            "dates.start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dates.end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dates.month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "dates.nights": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "dates.shift_days": {
              "type": "integer",
              "minimum": -60,
              "maximum": 60
            },
            "dates.flexible_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 14
            },
            "party.segment": {
              "enum": [
                "solo",
                "couple",
                "family",
                "friends",
                "other"
              ]
            },
            "party.adults": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "party.children": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "party.children_ages": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17
              }
            },
            "party.pets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "budget_rub.max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "prefs.meals": {
              "enum": [
                "any",
                "none",
                "breakfast",
                "half_board",
                "full_board",
                "all_inclusive"
              ]
            },
            "prefs.free_cancellation": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "prefs.stars_min": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "prefs.direct_only": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "prefs.max_travel_hours": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "prefs.district": {
              "enum": [
                "any",
                "lively",
                "quiet",
                "family",
                "walkable"
              ]
            },
            "prefs.beach_max_m": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "prefs.transport": {
              "enum": [
                "any",
                "plane",
                "train"
              ]
            },
            "constraints.add": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z_]+(:[a-z_]+)?$"
              },
              "minItems": 1
            },
            "constraints.remove": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z_]+(:[a-z_]+)?$"
              },
              "minItems": 1
            },
            "traits.add": {
              "type": "array",
              "items": {
                "enum": [
                  "sea",
                  "beach",
                  "mountains",
                  "lake",
                  "river",
                  "island",
                  "forest",
                  "desert",
                  "warm",
                  "hot",
                  "cold",
                  "snow",
                  "tropical",
                  "city",
                  "resort",
                  "nature",
                  "village",
                  "history",
                  "culture",
                  "food",
                  "nightlife",
                  "ski",
                  "spa",
                  "shopping",
                  "architecture"
                ]
              },
              "minItems": 1
            },
            "mood.add": {
              "type": "array",
              "items": {
                "enum": [
                  "relax",
                  "party",
                  "culture",
                  "active",
                  "romantic",
                  "kids_fun"
                ]
              },
              "minItems": 1
            },
            "origin.city": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "array",
              "items": {
                "enum": [
                  "flights",
                  "trains",
                  "stay",
                  "transfers"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "unset": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "destination.name",
              "dates.start",
              "dates.end",
              "dates.month",
              "dates.nights",
              "dates.flexible_days",
              "party.children_ages",
              "party.pets",
              "budget_rub.max",
              "prefs.meals",
              "prefs.free_cancellation",
              "prefs.stars_min",
              "prefs.direct_only",
              "prefs.max_travel_hours",
              "prefs.district",
              "prefs.beach_max_m",
              "prefs.transport",
              "constraints.add",
              "traits.add",
              "mood.add",
              "origin.city",
              "scope"
            ]
          }
        }
      }
    },
    "refs": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "destination",
              "variant",
              "hotel",
              "question"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/image"
        }
      ]
    },
    "info_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "post_purchase": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "params"
          ],
          "properties": {
            "kind": {
              "enum": [
                "early_checkin",
                "change_dates",
                "add_transfer"
              ]
            },
            "params": {
              "type": "object"
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "traits"
      ],
      "properties": {
        "place": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "country",
                "confidence"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "country": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "traits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "landscape",
            "water",
            "climate",
            "setting",
            "vibe"
          ],
          "properties": {
            "landscape": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "beach",
                  "coast",
                  "mountains",
                  "forest",
                  "desert",
                  "lake",
                  "river",
                  "island",
                  "plains",
                  "old_town",
                  "skyline",
                  "countryside",
                  "snow"
                ]
              }
            },
            "water": {
              "enum": [
                "sea",
                "lake",
                "river",
                "none"
              ]
            },
            "climate": {
              "enum": [
                "tropical",
                "warm",
                "temperate",
                "cold",
                "snow"
              ]
            },
            "setting": {
              "enum": [
                "city",
                "resort",
                "nature",
                "village"
              ]
            },
            "vibe": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "relax",
                  "party",
                  "culture",
                  "active",
                  "romantic",
                  "kids_fun",
                  "luxury",
                  "budget",
                  "quiet",
                  "lively",
                  "exotic",
                  "cozy"
                ]
              }
            }
          }
        }
      }
    }
  }
}
