# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Target model for the agent: deepseek-flash (DeepSeek-V4.1-Flash)
DEEPSEEK_API_KEY=

# OpenRouter: Jev (typesafe/jev-1.13), the portability check model, and Sonnet for the eval persona
OPENROUTER_API_KEY=

# Optional: Sonnet for the eval persona directly from Anthropic instead of OpenRouter
ANTHROPIC_API_KEY=
